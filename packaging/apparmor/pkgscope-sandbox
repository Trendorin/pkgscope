# AppArmor profile that lets pkgscope-sandbox create unprivileged user
# namespaces on distributions that restrict them by default (Ubuntu 24.04+).
#
# The Debian package installs it. Source installs and the AppImage use pkgscope-sandbox-local
# instead ("install.sh --setup", "PkgScope-*.AppImage --setup-sandbox"), which names a root-owned
# copy of the helper: never point a profile at a helper in your home directory, any program you
# run could replace it and inherit the permission.
#
# This grants ONLY the ability to set up user namespaces; the real confinement
# of analysed programs is done by pkgscope-sandbox itself (namespaces, overlay,
# dropped capabilities and seccomp).
abi <abi/4.0>,
include <tunables/global>

profile pkgscope-sandbox /usr/{lib,libexec}/pkgscope/pkgscope-sandbox flags=(unconfined) {
  userns,
  include if exists <local/pkgscope-sandbox>
}
